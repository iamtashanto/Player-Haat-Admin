# API base URL. Leave unset in dev to use the Vite proxy (/api/v1 -> http://localhost:4000).
# In production set to the API origin, e.g. https://api.playerhaat.com/api/v1
VITE_API_URL=

# DEV ONLY (ignored in production builds): allow sign-in with password alone, before the backend
# implements the mandatory-2FA endpoints. Never set this on a deployed environment.
VITE_ALLOW_NO_2FA_DEV=false
